<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <Button
            android:id="@+id/btn_playback_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="播放紀錄"
            android:layout_marginBottom="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="隱私設定"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="語言 / Language"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#1E1E1E">

            <RadioGroup
                android:id="@+id/rg_language"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <RadioButton
                    android:id="@+id/rb_language_auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="跟隨手機語言"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rb_language_zh_tw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="繁體中文"
                    android:textColor="#FFFFFF" />

                <RadioButton
                    android:id="@+id/rb_language_en"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="English"
                    android:textColor="#FFFFFF" />
            </RadioGroup>
        </androidx.cardview.widget.CardView>

        <!-- App Lock Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="應用鎖定"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#1E1E1E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="啟用生物識別鎖定"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_lock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_set_pin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#3700B3"
                    android:text="設定 PIN 碼 (備用)"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="APP 後台關閉或超過 1 小時後需重新驗證"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Screen Secure Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="#1A237E"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔒 防截圖 / 防投屏"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_screen_secure"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="關閉後可截圖、螢幕錄影及遠端投屏。重新開啟 APP 後生效。"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Player Controls Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="播放器控制"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#1E1E1E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="永遠使用內建播放器"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switch_always_internal_player"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="開啟後，所有解析出的影片網址都直接使用內建播放器，不再呼叫外部播放器或本機 Proxy。"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_press_hold_speed_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="長按畫面快轉倍速"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/et_press_hold_playback_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:inputType="numberDecimal"
                    android:singleLine="true"
                    android:hint="預設 3x"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:backgroundTint="#3700B3"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/btn_save_press_hold_playback_rate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#3700B3"
                    android:text="儲存長按快轉倍速"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tv_press_hold_speed_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="按住影片畫面時暫時加速，放開後恢復原倍率；可設定 1.25x–16x。"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="快退 / 快進按鈕秒數"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_player_short_seek_seconds"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:maxLength="4"
                        android:hint="短距離 20 秒"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:backgroundTint="#3700B3"
                        android:padding="12dp" />

                    <EditText
                        android:id="@+id/et_player_long_seek_seconds"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:inputType="number"
                        android:maxLength="4"
                        android:hint="長距離 60 秒"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:backgroundTint="#3700B3"
                        android:padding="12dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_save_player_seek_buttons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#3700B3"
                    android:text="儲存快退 / 快進按鈕"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="播放速度選項"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/et_playback_speed_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:inputType="textNoSuggestions"
                    android:singleLine="true"
                    android:hint="0.75,1,1.5,2,3,6,12,16"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:backgroundTint="#3700B3"
                    android:padding="12dp" />

                <Button
                    android:id="@+id/btn_save_playback_speed_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="#3700B3"
                    android:text="儲存播放速度選項"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:text="倍速請用逗號分隔，可設定 0.25x–16x、最多 12 個；1x 會自動保留。"
                    android:textColor="#888888"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="雙擊左/右側快退快進秒數"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_double_tap_seek_seconds"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:maxLength="3"
                        android:hint="30"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#888888"
                        android:backgroundTint="#3700B3"
                        android:padding="12dp" />

                    <Button
                        android:id="@+id/btn_save_double_tap_seek_seconds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:backgroundTint="#3700B3"
                        android:text="儲存"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="可設定 5-300 秒。雙擊左側倒退，雙擊右側前進；中間區域保留給顯示/隱藏控制列。"
                    android:textColor="#888888"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- App Icon Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="應用外觀"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#1E1E1E">

            <RadioGroup
                android:id="@+id/radio_group_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RadioButton
                    android:id="@+id/radio_default"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎬 JAV Browser（預設）"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="12dp" />

                <RadioButton
                    android:id="@+id/radio_calculator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔢 Calculator（計算機）"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="12dp" />

                <RadioButton
                    android:id="@+id/radio_notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📝 Notes（記事本）"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="12dp" />

                <RadioButton
                    android:id="@+id/radio_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📁 File Manager（檔案管理）"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:padding="12dp" />
            </RadioGroup>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ 更換圖標後，舊圖標會從桌面消失，新圖標會出現\n⚠️ 部分啟動器可能需要重啟才能看到變化"
            android:textColor="#FF9800"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- Ad Filter Rules Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="廣告過濾規則"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#1E1E1E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Cloud URL Input -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="雲端規則網址"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_cloud_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="輸入 GitHub 規則文件網址"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:backgroundTint="#3700B3"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_update_from_cloud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#3700B3"
                    android:text="從雲端更新規則"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp" />

                <!-- Rules Stats -->
                <TextView
                    android:id="@+id/tv_rules_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="載入中..."
                    android:textColor="#BBBBBB"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <!-- Export/Import Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_export_rules"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#2196F3"
                        android:text="導出規則"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btn_import_rules"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="#4CAF50"
                        android:text="導入規則"
                        android:textColor="#FFFFFF" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_user_block_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FF5722"
                    android:text="我的屏蔽列表"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="12dp" />

                <Button
                    android:id="@+id/btn_user_dom_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FF5722"
                    android:text="我屏蔽的元素"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Favorites Backup Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="書籤備份"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#1E1E1E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <Button
                    android:id="@+id/btn_import_favorites"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#4CAF50"
                    android:text="📥 匯入書籤"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btn_export_favorites"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#2196F3"
                    android:text="📤 匯出書籤"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- JavDB Auto-Tagging Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="書籤自動分類（JavDB）"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#1E1E1E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Scrape.do API Token"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/et_scrapedo_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="貼上你的 Scrape.do Token"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:backgroundTint="#3700B3"
                    android:padding="12dp"
                    android:inputType="textVisiblePassword"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btn_save_scrapedo_token"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#3700B3"
                    android:text="儲存 Token"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="查詢方式"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <RadioGroup
                    android:id="@+id/rg_enrich_method"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <RadioButton
                        android:id="@+id/rb_method_scrapedo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Scrape.do API（付費，需 Token）"
                        android:textColor="#FFFFFF"
                        android:buttonTint="#BB86FC" />

                    <RadioButton
                        android:id="@+id/rb_method_webview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WebView（免費，較慢）"
                        android:textColor="#FFFFFF"
                        android:buttonTint="#BB86FC" />

                </RadioGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="加入書籤時，APP 會自動用番號查詢 JavDB，填入女優、片商、類別等標籤。每人請自行申請 Token 以避免額度共用。"
                    android:textColor="#888888"
                    android:textSize="11sp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Back Button -->
        <TextView
            android:id="@+id/tv_telemetry_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="使用統計與閃退回報已啟用。此版本使用 Firebase 收集啟動、功能使用、播放與下載結果、裝置資訊及錯誤診斷；不傳送瀏覽網址、搜尋詞、影片名稱或播放紀錄。"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />
        <Button
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="返回"
            android:backgroundTint="#BB86FC"
            android:textColor="#000000" />

        <include layout="@layout/include_footer" />

    </LinearLayout>
</ScrollView>
